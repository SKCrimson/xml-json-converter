{
    "configuration": {
        "configSections": {
            "section": {
                "@name": "entityFramework",
                "@type": "System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089",
                "@requirePermission": "false"
            }
        },
        "appSettings": {
            "add": [
                {
                    "@key": "ChartImageHandler",
                    "@value": "Storage=file;Timeout=20;Url=~/Account/Admin/tempImages/;"
                },
                {
                    "@key": "DatabaseName",
                    "@value": "ekonservissy"
                },
                {
                    "@key": "host",
                    "@value": "smtp.zoner.com"
                },
                {
                    "@key": "hostMail",
                    "@value": "robot@ekonservis.cz"
                },
                {
                    "@key": "hostPass",
                    "@value": "balbalbla"
                }
            ]
        },
        "connectionStrings": {
            "add": {
                "@name": "ApplicationServices",
                "@connectionString": "Data Source=localhost\\SQLEXPRESS;Initial Catalog=ekonservissy;persist security info=True;Integrated Security=SSPI;",
                "@providerName": "System.Data.SqlClient"
            }
        },
        "system.web": {
            "compilation": {
                "@targetFramework": "4.8",
                "@debug": "true",
                "assemblies": {
                    "add": [
                        {
                            "@assembly": "System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089"
                        },
                        {
                            "@assembly": "System.Web.DataVisualization, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35"
                        }
                    ]
                }
            },
            "authentication": {
                "@mode": "Forms",
                "forms": {
                    "@name": ".EKONSYS",
                    "@loginUrl": "~/Account/Divarication.aspx",
                    "@timeout": "120",
                    "@slidingExpiration": "true",
                    "@cookieless": "UseCookies",
                    "@protection": "All",
                    "@requireSSL": "false",
                    "@enableCrossAppRedirects": "false",
                    "@defaultUrl": "~/Account/Divarication.aspx",
                    "@path": "/"
                }
            },
            "membership": {
                "@defaultProvider": "InsuranceMembershipProvider",
                "providers": {
                    "add": {
                        "@name": "InsuranceMembershipProvider",
                        "@applicationName": "InsuranceWebAssistant",
                        "@connectionStringName": "ApplicationServices",
                        "@passwordFormat": "Hashed",
                        "@enablePasswordRetrieval": "false",
                        "@enablePasswordReset": "true",
                        "@requiresQuestionAndAnswer": "false",
                        "@requiresUniqueEmail": "false",
                        "@minRequiredPasswordLength": "6",
                        "@minRequiredNonalphanumericCharacters": "0",
                        "@maxInvalidPasswordAttempts": "6",
                        "@passwordAttemptWindow": "20",
                        "@type": "System.Web.Security.SqlMembershipProvider"
                    }
                }
            },
            "sessionState": {
                "@mode": "InProc",
                "@timeout": "30",
                "@cookieless": "UseCookies",
                "@cookieName": ".EKONSYS_ID",
                "@regenerateExpiredSessionId": "true"
            },
            "roleManager": {
                "@enabled": "true",
                "providers": {
                    "clear": {
                    },
                    "add": {
                        "@connectionStringName": "ApplicationServices",
                        "@applicationName": "InsuranceWebAssistant",
                        "@name": "AspNetSqlRoleProvider",
                        "@type": "System.Web.Security.SqlRoleProvider"
                    }
                }
            },
            "httpHandlers": {
                "add": {
                    "@path": "ChartImg.axd",
                    "@verb": "GET,HEAD,POST",
                    "@type": "System.Web.UI.DataVisualization.Charting.ChartHttpHandler, System.Web.DataVisualization, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35",
                    "@validate": "false"
                }
            },
            "pages": {
                "controls": {
                    "add": [
                        {
                            "@tagPrefix": "asp",
                            "@namespace": "System.Web.UI.DataVisualization.Charting",
                            "@assembly": "System.Web.DataVisualization, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35"
                        },
                        {
                            "@tagPrefix": "ajaxToolkit",
                            "@assembly": "AjaxControlToolkit",
                            "@namespace": "AjaxControlToolkit"
                        }
                    ]
                }
            },
            "httpRuntime": {
                "@maxRequestLength": "14336"
            },
            "customErrors": {
                "@mode": "Off"
            }
        },
        "system.webServer": {
            "modules": {
                "@runAllManagedModulesForAllRequests": "true"
            },
            "validation": {
                "@validateIntegratedModeConfiguration": "false"
            },
            "handlers": {
                "remove": {
                    "@name": "ChartImageHandler"
                },
                "add": {
                    "@name": "ChartImageHandler",
                    "@preCondition": "integratedMode",
                    "@verb": "GET,HEAD,POST",
                    "@path": "ChartImg.axd",
                    "@type": "System.Web.UI.DataVisualization.Charting.ChartHttpHandler, System.Web.DataVisualization, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35"
                }
            }
        },
        "system.serviceModel": {
            "services": {
                "service": [
                    {
                        "@name": "InsuranceWebAssistant.Services.SystemOnlineTestService",
                        "@behaviorConfiguration": "CommonBehaviors",
                        "endpoint": {
                            "@name": "SystemOnlineTestEndpoint",
                            "@address": "/Services/SystemOnlineTestService",
                            "@binding": "wsHttpBinding",
                            "@bindingConfiguration": "CommonBinding",
                            "@contract": "InsuranceWebAssistant.Services.ISystemOnlineTestService"
                        }
                    },
                    {
                        "@name": "InsuranceWebAssistant.Services.ErrorLogService",
                        "@behaviorConfiguration": "CommonBehaviors",
                        "endpoint": {
                            "@name": "ErrorLogEndpoint",
                            "@address": "/Services/ErrorLogService",
                            "@binding": "wsHttpBinding",
                            "@bindingConfiguration": "CommonBinding",
                            "@contract": "InsuranceWebAssistant.Services.IErrorLogService"
                        }
                    },
                    {
                        "@name": "InsuranceWebAssistant.Services.MapTasksService",
                        "@behaviorConfiguration": "CommonBehaviors",
                        "endpoint": {
                            "@name": "MapTasksEndpoint",
                            "@address": "/Services/MapTasksService",
                            "@binding": "wsHttpBinding",
                            "@bindingConfiguration": "CommonBinding",
                            "@contract": "InsuranceWebAssistant.Services.IMapTasksService"
                        }
                    },
                    {
                        "@name": "InsuranceWebAssistant.Services.CompanyExpensesService",
                        "@behaviorConfiguration": "CommonBehaviors",
                        "endpoint": {
                            "@name": "CompanyExpensesEndpoint",
                            "@address": "/Services/CompanyExpensesService",
                            "@binding": "wsHttpBinding",
                            "@bindingConfiguration": "CommonBinding",
                            "@contract": "InsuranceWebAssistant.Services.ICompanyExpensesService"
                        }
                    },
                    {
                        "@name": "InsuranceWebAssistant.Services.CompanyBillingService",
                        "@behaviorConfiguration": "CommonBehaviors",
                        "endpoint": {
                            "@name": "CompanyBillingEndpoint",
                            "@address": "/Services/CompanyBillingService",
                            "@binding": "wsHttpBinding",
                            "@bindingConfiguration": "CommonBinding",
                            "@contract": "InsuranceWebAssistant.Services.ICompanyBillingService"
                        }
                    }
                ]
            },
            "bindings": {
                "wsHttpBinding": {
                    "binding": {
                        "@name": "CommonBinding",
                        "@maxReceivedMessageSize": "2097152",
                        "@maxBufferPoolSize": "2097152",
                        "security": {
                            "@mode": "None"
                        }
                    }
                }
            },
            "behaviors": {
                "serviceBehaviors": {
                    "behavior": {
                        "@name": "CommonBehaviors",
                        "serviceMetadata": {
                            "@httpGetEnabled": "true",
                            "@httpsGetEnabled": "true"
                        },
                        "serviceDebug": {
                            "@includeExceptionDetailInFaults": "true"
                        }
                    }
                }
            },
            "serviceHostingEnvironment": {
                "@aspNetCompatibilityEnabled": "true",
                "@multipleSiteBindingsEnabled": "true"
            }
        },
        "entityFramework": {
            "defaultConnectionFactory": {
                "@type": "System.Data.Entity.Infrastructure.SqlConnectionFactory, EntityFramework"
            },
            "providers": {
                "provider": {
                    "@invariantName": "System.Data.SqlClient",
                    "@type": "System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer"
                }
            }
        },
        "runtime": {
            "assemblyBinding": {
                "@xmlns": "urn:schemas-microsoft-com:asm.v1",
                "dependentAssembly": [
                    {
                        "assemblyIdentity": {
                            "@name": "Microsoft.Data.Services",
                            "@publicKeyToken": "31bf3856ad364e35",
                            "@culture": "neutral"
                        },
                        "bindingRedirect": {
                            "@oldVersion": "0.0.0.0-5.8.1.0",
                            "@newVersion": "5.8.1.0"
                        }
                    },
                    {
                        "assemblyIdentity": {
                            "@name": "Microsoft.Data.Services.Client",
                            "@publicKeyToken": "31bf3856ad364e35",
                            "@culture": "neutral"
                        },
