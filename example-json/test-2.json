                        }
                    },
                    {
                        "assemblyIdentity": {
                            "@name": "System.Buffers",
                            "@publicKeyToken": "cc7b13ffcd2ddd51",
                            "@culture": "neutral"
                        },
                        "bindingRedirect": {
                            "@oldVersion": "0.0.0.0-4.0.3.0",
